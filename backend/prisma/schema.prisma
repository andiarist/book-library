
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum BookFormat {
  EPUB
  PDF
  PHYSICAL
  MOBI
  AZW3
}

model Book {
  id           Int          @id @default(autoincrement())
  title        String
  isbn         String?      @unique
  format       BookFormat
  publisher    String?
  publishYear  Int?
  pageCount    Int?
  description  String?
  filePath     String?      @unique
  fileHash     String?      @unique
  coverPath    String?      // Ruta local en /storage/covers
  authors      Author[]
  categories   Category[]
  series       Series?      @relation(fields: [seriesId], references: [id])
  seriesId     Int?
  seriesOrder  Float?       // Permite órdenes como 1.5
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Author {
  id    Int    @id @default(autoincrement())
  name  String @unique
  books Book[]
}

model Category {
  id    Int    @id @default(autoincrement())
  name  String @unique
  books Book[]
}

model Series {
  id    Int    @id @default(autoincrement())
  name  String @unique
  books Book[]
}
